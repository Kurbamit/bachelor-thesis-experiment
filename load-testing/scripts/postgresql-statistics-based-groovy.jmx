              <stringProp name="script">import java.sql.Connection
import java.sql.PreparedStatement

Connection conn = null
PreparedStatement pstmt = null

try {
    conn = org.apache.jmeter.protocol.jdbc.config.DataSourceElement.getConnection(&quot;pg&quot;)
    
    String sql = &quot;WITH deleted AS ( &quot; +
                 &quot;DELETE FROM public.cart_items &quot; +
                 &quot;WHERE tenant_id = ?::uuid AND cart_item_id = ?::uuid RETURNING cart_id) &quot; +
                 &quot;UPDATE public.carts SET updated_at = NOW() &quot; +
                 &quot;WHERE tenant_id = ?::uuid AND cart_id IN (SELECT cart_id FROM deleted)&quot;
    
    pstmt = conn.prepareStatement(sql)
    pstmt.setString(1, vars.get(&quot;t_tenant_id&quot;))
    pstmt.setString(2, vars.get(&quot;cart_item_id&quot;))
    pstmt.setString(3, vars.get(&quot;t_tenant_id&quot;))
    
    int deleted = pstmt.executeUpdate()
    
    SampleResult.setResponseMessage(&quot;Item removed, rows: &quot; + deleted)
    SampleResult.setSuccessful(deleted &gt; 0)
} catch (Exception e) {
    SampleResult.setResponseMessage(&quot;Error: &quot; + e.getMessage())
    SampleResult.setSuccessful(false)
    log.error(&quot;Remove Item error&quot;, e)
} finally {
    if (pstmt != null) pstmt.close()
    if (conn != null) conn.close()
}</stringProp>
