            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Update Quantity" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.sql.Connection
import java.sql.PreparedStatement

Connection conn = null
PreparedStatement pstmt = null

try {
    conn = org.apache.jmeter.protocol.jdbc.config.DataSourceElement.getConnection(&quot;pg&quot;)
    
    String sql = &quot;WITH updated AS ( &quot; +
                 &quot;UPDATE public.cart_items SET quantity = ? &quot; +
                 &quot;WHERE tenant_id = ?::uuid AND cart_item_id = ?::uuid RETURNING cart_id) &quot; +
                 &quot;UPDATE public.carts SET updated_at = NOW() &quot; +
                 &quot;WHERE tenant_id = ?::uuid AND cart_id IN (SELECT cart_id FROM updated)&quot;
    
    pstmt = conn.prepareStatement(sql)
    pstmt.setInt(1, 2)
    pstmt.setString(2, vars.get(&quot;t_tenant_id&quot;))
    pstmt.setString(3, vars.get(&quot;cart_item_id&quot;))
    pstmt.setString(4, vars.get(&quot;t_tenant_id&quot;))
    
    int updated = pstmt.executeUpdate()
    
    SampleResult.setResponseMessage(&quot;Quantity updated, rows: &quot; + updated)
    SampleResult.setSuccessful(updated &gt; 0)
} catch (Exception e) {
    SampleResult.setResponseMessage(&quot;Error: &quot; + e.getMessage())
    SampleResult.setSuccessful(false)
    log.error(&quot;Update Quantity error&quot;, e)
} finally {
    if (pstmt != null) pstmt.close()
    if (conn != null) conn.close()
}</stringProp>
