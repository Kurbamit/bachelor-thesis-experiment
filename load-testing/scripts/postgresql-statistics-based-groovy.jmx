                 &quot;DELETE FROM public.cart_items &quot; +
                 &quot;WHERE tenant_id = ?::uuid AND cart_item_id = ?::uuid RETURNING cart_id) &quot; +
                 &quot;UPDATE public.carts SET updated_at = NOW() &quot; +
