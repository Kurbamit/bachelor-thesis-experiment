              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.sql.Connection
import java.sql.PreparedStatement
import java.sql.ResultSet

Connection conn = null
PreparedStatement pstmt = null
ResultSet rs = null

try {
    conn = org.apache.jmeter.protocol.jdbc.config.DataSourceElement.getConnection(&quot;pg&quot;)
    
    String sql = &quot;INSERT INTO public.cart_items (tenant_id, cart_item_id, cart_id, product_id, variant_id, quantity, created_at) &quot; +
                 &quot;VALUES (?::uuid, gen_random_uuid(), ?::uuid, ?::uuid, ?::uuid, 1, NOW()) RETURNING cart_item_id&quot;
    
    pstmt = conn.prepareStatement(sql)
    pstmt.setString(1, vars.get(&quot;t_tenant_id&quot;))
    pstmt.setString(2, vars.get(&quot;cart_id&quot;))
    pstmt.setString(3, vars.get(&quot;t_product_id&quot;))
    pstmt.setString(4, vars.get(&quot;t_variant_id&quot;))
    
    rs = pstmt.executeQuery()
    
    if (rs.next()) {
        String cartItemId = rs.getString(&quot;cart_item_id&quot;)
        vars.put(&quot;cart_item_id&quot;, cartItemId)
        SampleResult.setResponseMessage(&quot;Item added: &quot; + cartItemId)
        SampleResult.setSuccessful(true)
    } else {
        SampleResult.setResponseMessage(&quot;Failed to add item&quot;)
        SampleResult.setSuccessful(false)
    }
} catch (Exception e) {
    SampleResult.setResponseMessage(&quot;Error: &quot; + e.getMessage())
    SampleResult.setSuccessful(false)
    log.error(&quot;Add Item error&quot;, e)
} finally {
    if (rs != null) rs.close()
    if (pstmt != null) pstmt.close()
    if (conn != null) conn.close()
}</stringProp>
            </JSR223Sampler>
