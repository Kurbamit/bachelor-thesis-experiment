            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Get Cart" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.sql.Connection
import java.sql.PreparedStatement
import java.sql.ResultSet

Connection conn = null
PreparedStatement pstmt = null
ResultSet rs = null

try {
    conn = org.apache.jmeter.protocol.jdbc.config.DataSourceElement.getConnection(&quot;pg&quot;)
    
    String sql = &quot;SELECT c.cart_id FROM public.carts c &quot; +
                 &quot;LEFT JOIN public.cart_items ci ON c.cart_id = ci.cart_id AND c.tenant_id = ci.tenant_id &quot; +
                 &quot;WHERE c.tenant_id = ?::uuid AND c.cart_id = ?::uuid&quot;
    
    pstmt = conn.prepareStatement(sql)
    pstmt.setString(1, vars.get(&quot;t_tenant_id&quot;))
    pstmt.setString(2, vars.get(&quot;cart_id&quot;))
    
    rs = pstmt.executeQuery()
    
    int rowCount = 0
    while (rs.next()) {
        rowCount++
    }
    
    SampleResult.setResponseMessage(&quot;Cart retrieved, rows: &quot; + rowCount)
    SampleResult.setSuccessful(true)
} catch (Exception e) {
    SampleResult.setResponseMessage(&quot;Error: &quot; + e.getMessage())
    SampleResult.setSuccessful(false)
    log.error(&quot;Get Cart error&quot;, e)
} finally {
    if (rs != null) rs.close()
    if (pstmt != null) pstmt.close()
    if (conn != null) conn.close()
}</stringProp>
