              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import redis.clients.jedis.JedisCluster
import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def jedis = props.get(&quot;jedisCluster&quot;)
def tId = vars.get(&quot;t_tenant_id&quot;)
def uId = vars.get(&quot;t_user_id&quot;)
def pId = vars.get(&quot;t_product_id&quot;)
def vId = vars.get(&quot;t_variant_id&quot;)
def iId = java.util.UUID.randomUUID().toString()
vars.put(&quot;cart_item_id&quot;, iId)

def key = &quot;cart:{${tId}}:${uId}&quot;
def cartJson = jedis.get(key)
def cart

if (cartJson) {
    cart = new JsonSlurper().parseText(cartJson)
} else {
    cart = [cart_id: vars.get(&quot;cart_id&quot;), tenant_id: tId, user_id: uId, items: [], created_at: System.currentTimeMillis(), updated_at: System.currentTimeMillis()]
}

cart.items.add([cart_item_id: iId, product_id: pId, variant_id: vId, quantity: 1, created_at: System.currentTimeMillis()])
cart.updated_at = System.currentTimeMillis()

jedis.setex(key, 86400, JsonOutput.toJson(cart))
SampleResult.setSuccessful(true)</stringProp>
