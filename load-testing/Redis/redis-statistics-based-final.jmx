        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Close Jedis Cluster" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import redis.clients.jedis.JedisCluster

try {
    def jedisCluster = props.get(&quot;jedisCluster&quot;)
    if (jedisCluster != null) {
        jedisCluster.close()
        log.info(&quot;Redis Cluster connection closed&quot;)
    }
    SampleResult.setResponseMessage(&quot;Cleanup completed&quot;)
    SampleResult.setSuccessful(true)
} catch (Exception e) {
    log.error(&quot;Cleanup error: &quot; + e.getMessage())
    SampleResult.setResponseMessage(&quot;Cleanup error: &quot; + e.getMessage())
    SampleResult.setSuccessful(false)
}
</stringProp>
        </JSR223PostProcessor>
