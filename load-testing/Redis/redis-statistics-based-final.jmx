              <stringProp name="script">import redis.clients.jedis.JedisCluster
import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def jedis = props.get(&quot;jedisCluster&quot;)
def tId = vars.get(&quot;t_tenant_id&quot;)
def uId = vars.get(&quot;t_user_id&quot;)
def pId = vars.get(&quot;t_product_id&quot;)
def vId = vars.get(&quot;t_variant_id&quot;)
def iId = java.util.UUID.randomUUID().toString()
vars.put(&quot;cart_item_id&quot;, iId)

def key = &quot;cart:{${tId}}:${uId}&quot;
def cartJson = jedis.get(key)
def cart

if (cartJson) {
