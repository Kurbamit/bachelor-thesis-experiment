            <stringProp name="script">import redis.clients.jedis.JedisCluster

def jedis = props.get(&quot;jedisCluster&quot;)
def tId = vars.get(&quot;t_tenant_id&quot;)
def uId = vars.get(&quot;t_user_id&quot;)
def cId = java.util.UUID.randomUUID().toString()
vars.put(&quot;cart_id&quot;, cId)

// Simple JSON string - no parsing needed
def json = &apos;{&quot;cart_id&quot;:&quot;&apos; + cId + &apos;&quot;,&quot;tenant_id&quot;:&quot;&apos; + tId + &apos;&quot;,&quot;user_id&quot;:&quot;&apos; + uId + &apos;&quot;,&quot;items&quot;:[],&quot;created_at&quot;:&apos; + System.currentTimeMillis() + &apos;,&quot;updated_at&quot;:&apos; + System.currentTimeMillis() + &apos;}&apos;

jedis.setex(&quot;cart:{${tId}}:${uId}&quot;, 86400, json)
SampleResult.setSuccessful(true)</stringProp>
