      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Initialize Jedis Cluster">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import redis.clients.jedis.JedisCluster
import redis.clients.jedis.HostAndPort
import redis.clients.jedis.JedisPoolConfig

JedisPoolConfig poolConfig = new JedisPoolConfig()
poolConfig.setMaxTotal(1000)
poolConfig.setMaxIdle(200)
poolConfig.setMinIdle(100)
poolConfig.setTestOnBorrow(true)
poolConfig.setTestOnReturn(false)
poolConfig.setTestWhileIdle(false)
poolConfig.setBlockWhenExhausted(true)
poolConfig.setMaxWaitMillis(5000)

Set&lt;HostAndPort&gt; nodes = new HashSet&lt;&gt;()
nodes.add(new HostAndPort(vars.get(&quot;redisHost1&quot;), vars.get(&quot;redisPort1&quot;).toInteger()))
nodes.add(new HostAndPort(vars.get(&quot;redisHost2&quot;), vars.get(&quot;redisPort2&quot;).toInteger()))
nodes.add(new HostAndPort(vars.get(&quot;redisHost3&quot;), vars.get(&quot;redisPort3&quot;).toInteger()))


try {
    JedisCluster jedisCluster = new JedisCluster(nodes, 10000, 10000, 5, poolConfig)
    props.put(&quot;jedisCluster&quot;, jedisCluster)
    log.info(&quot;Redis Cluster initialized&quot;)
    SampleResult.setSuccessful(true)
} catch (Exception e) {
    log.error(&quot;Failed to initialize: &quot; + e.getMessage())
    SampleResult.setSuccessful(false)
}
</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
      </hashTree>
