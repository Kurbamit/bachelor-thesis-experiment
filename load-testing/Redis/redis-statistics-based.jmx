          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Update Quantity" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">import redis.clients.jedis.JedisCluster
import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def jedisCluster = props.get(&quot;jedisCluster&quot;)
def tenantId = vars.get(&quot;t_tenant_id&quot;)
def userId = vars.get(&quot;t_user_id&quot;)
def cartId = vars.get(&quot;cart_id&quot;)
def cartItemId = vars.get(&quot;cart_item_id&quot;)

def cartItemsKey = &quot;cart_items:{${tenantId}}:${cartId}&quot;

try {
    long startTime = System.currentTimeMillis()
    def itemJson = jedisCluster.hget(cartItemsKey, cartItemId)
    if (itemJson) {
        def jsonSlurper = new JsonSlurper()
        def itemData = jsonSlurper.parseText(itemJson)
        def currentQty = itemData.quantity?.toInteger() ?: 1
        itemData.quantity = String.valueOf(currentQty + 1)
        jedisCluster.hset(cartItemsKey, cartItemId, JsonOutput.toJson(itemData))
        def cartKey = &quot;cart:{${tenantId}}:${userId}:${cartId}&quot;
        jedisCluster.hset(cartKey, &quot;updated_at&quot;, String.valueOf(System.currentTimeMillis()))
        long endTime = System.currentTimeMillis()
        SampleResult.setResponseMessage(&quot;Quantity updated&quot;)
        SampleResult.setSuccessful(true)
        SampleResult.setLatency(endTime - startTime)
    } else {
        SampleResult.setResponseMessage(&quot;Item not found&quot;)
        SampleResult.setSuccessful(false)
    }
} catch (Exception e) {
    SampleResult.setResponseMessage(&quot;Failed: &quot; + e.getMessage())
    SampleResult.setSuccessful(false)
}</stringProp>
            </JSR223Sampler>
