          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">/Users/dominykas.cernovas/Documents/Vilnius University/4_year/kursinis_darbas/eksperimentas/Sharding/load-testing/API-test/cart_items.csv</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
