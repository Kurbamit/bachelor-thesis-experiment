            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Remove Item" enabled="true">
              <stringProp name="dataSource">pg</stringProp>
              <stringProp name="queryType">Prepared Update Statement</stringProp>
              <stringProp name="query">WITH deleted AS (
  DELETE FROM public.cart_items
  WHERE tenant_id = ?::uuid
    AND cart_item_id = &apos;${cart_item_id}&apos;::uuid
  RETURNING cart_id
)
UPDATE public.carts
SET updated_at = NOW()
WHERE tenant_id = ?::uuid
  AND cart_id IN (SELECT cart_id FROM deleted);</stringProp>
              <stringProp name="queryArguments">${t_tenant_id},${t_tenant_id}</stringProp>
              <stringProp name="queryArgumentsTypes">VARCHAR,VARCHAR</stringProp>
